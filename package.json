{
  "name": "fridge-to-recipe",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently -n api,web \"npm:server\" \"npm:dev\"",
    "server": "node server/index.js",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite build && NODE_ENV=production node server/index.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
